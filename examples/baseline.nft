# Generated by VPS Safe; only this named table is managed.
table inet vps_safe {
  comment "managed-by-vps-safe"
  set wan { type ifname; elements = { "eth0" }; }
  set management { type inet_service; elements = { 22 }; }
  set allowed_tcp { type inet_service; elements = { 80, 443 }; }
  set allowed_udp { type inet_service; }
  set blocked_tcp { type inet_service; }
  set blocked_udp { type inet_service; }
  set smtp { type inet_service; elements = { 25, 465, 587, 2525 }; }
  set blocked_src4 { type ipv4_addr; flags interval; }
  set smtp_exempt4 { type ipv4_addr; flags interval; }
  set quarantine4 { type ipv4_addr; flags interval; }
  set source_policy4 { type ipv4_addr; flags interval; }
  set blocked_src6 { type ipv6_addr; flags interval; }
  set smtp_exempt6 { type ipv6_addr; flags interval; }
  set quarantine6 { type ipv6_addr; flags interval; }
  set source_policy6 { type ipv6_addr; flags interval; }
  chain ingress {
    type filter hook prerouting priority -150; policy accept;
    iifname != @wan return
    ct state invalid counter drop
    meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    tcp dport @management counter accept
    ct direction original ip saddr @blocked_src4 counter drop
    ct direction original ip6 saddr @blocked_src6 counter drop
    ct direction original tcp dport @blocked_tcp counter drop
    ct direction original udp dport @blocked_udp counter drop
  }
  chain input {
    type filter hook input priority -5; policy accept;
    ip saddr @quarantine4 counter drop
    ip6 saddr @quarantine6 counter drop
    iifname "lo" accept
    ct state established,related accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    tcp dport @management accept
    iifname @wan tcp dport @allowed_tcp accept
    iifname @wan udp dport @allowed_udp accept
  }
  chain forward {
    type filter hook forward priority -5; policy accept;
    ip saddr @quarantine4 counter drop
    ip daddr @quarantine4 counter drop
    ip6 saddr @quarantine6 counter drop
    ip6 daddr @quarantine6 counter drop
    oifname @wan tcp dport @smtp ip saddr @smtp_exempt4 accept
    oifname @wan tcp dport @smtp ip6 saddr @smtp_exempt6 accept
    oifname @wan tcp dport @smtp counter drop
  }
  chain output {
    type filter hook output priority -5; policy accept;
    ip daddr @quarantine4 counter drop
    ip6 daddr @quarantine6 counter drop
    oifname @wan tcp dport @smtp ip saddr @smtp_exempt4 accept
    oifname @wan tcp dport @smtp ip6 saddr @smtp_exempt6 accept
    oifname @wan tcp dport @smtp counter drop
  }
}
